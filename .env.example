# Copy to .env (Coolify pastes this into the "Environment Variables" tab).
# Everything below is optional — the server boots with sane defaults.

# Networking
PORT=3000
# Override only when the API cannot call itself on its listening port.
# CONVERT_API_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Performance knobs
CONVERT_API_MAX_CONCURRENCY=2
CONVERT_API_INLINE_THRESHOLD_MS=100
CONVERT_API_MAX_UPLOAD_BYTES=209715200
CONVERT_API_WARM_BROWSER=1

# Cache
CONVERT_API_CACHE_MAX_BYTES=536870912
CONVERT_API_CACHE_MAX_AGE_MS=86400000

# Jobs
CONVERT_API_JOB_TTL_MS=3600000
CONVERT_API_MAX_JOBS=5000

# Rate limit (per IP when no API keys are set)
CONVERT_API_RATE_RPM=120
CONVERT_API_BURST=30

# Optional integrations — leave blank to disable
# Get an OpenAI key to enable Whisper transcription:
# OPENAI_API_KEY=
# Get an Anthropic key to enable Claude summaries on transcripts:
# ANTHROPIC_API_KEY=

# Optional auth — comma-separated keys; clients pass "x-api-key: ..."
# CONVERT_API_KEYS=
